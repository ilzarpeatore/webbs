# Bloque a añadir al Caddyfile existente del VPS (esta VPS ya sirve otros
# dominios con Caddy — NO reemplaces el Caddyfile completo, solo añade este
# bloque al final). Caddy emite y renueva el certificado TLS de Let's Encrypt
# automáticamente en el primer reload, sin pasos manuales de Certbot.
#
# webbs corre en el contenedor Docker publicado en 127.0.0.1:3001 (ver
# docker-compose.yml) -- puerto distinto del resto de servicios de esta VPS.

bestronger.es, www.bestronger.es {
    reverse_proxy 127.0.0.1:3001
}

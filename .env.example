# URL base del backend (bckbs). El blog (/blog) lo consume server-side
# (Server Components de Next.js), por lo que no necesita CORS -- la petición
# nunca sale del navegador del visitante.
API_BASE_URL=https://testapp.bestronger.es/api

# Dominio canónico del sitio (sin barra final). Usado por metadataBase,
# el sitemap.xml y robots.txt.
SITE_URL=https://bestronger.es

# Measurement ID de Google Analytics 4 (panel de GA4 -> Admin -> Flujos de
# datos -> tu flujo web). Opcional: si se deja vacío no se carga gtag.js.
# Se lee en build time (ver Dockerfile), así que un cambio aquí en
# .env.production del VPS requiere `docker compose build` para aplicarse.
GA_MEASUREMENT_ID=
